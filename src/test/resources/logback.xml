<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss}] [%-5level] [%logger{20}] [%thread] - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.codeborne" level="WARN"/>   <!-- приглушить Selenide -->
    <logger name="com.codeborne.selenide.webdriver" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>