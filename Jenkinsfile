// =============================================================================
//  Сценарий сборки — что Jenkins делает при каждом запуске джобы.
//
//  НАЗНАЧЕНИЕ И МЕСТО В CI/CD
//  Это единственное описание прогона, и оно лежит в репозитории. Джоба
//  настроена как «Pipeline script from SCM»: Jenkins клонирует репозиторий
//  с GitHub и читает этот файл оттуда.
//  Следствие: правка действует только после `git push` — в отличие от
//  Dockerfile.agent, который читается локально при сборке образа.
//
//  Зачем файлом, а не настройками в интерфейсе: сценарий версионируется
//  вместе с кодом, виден в диффе и переживает пересоздание Jenkins.
//
//  Инфраструктура (сам Jenkins и агент) описана отдельно —
//  в docker-compose-jenkins.yml и Dockerfile.agent.
//
//  РАЗБОР ЭЛЕМЕНТОВ
//
//  ENV_URLS = [Prod: '...']   (объявлена ДО pipeline)
//      Сопоставление «алиас окружения → адрес стенда». Нужна потому, что
//      параметр джобы отдаёт ровно ту строку, которую выбрал человек:
//      из 'Prod' адрес конкатенацией не получить, в отличие от имени сьюта.
//      Новое окружение добавляется двумя строками — сюда и в choices.
//      Объявлена без `def` намеренно: у Jenkins CPS-движок, и переменная
//      верхнего уровня без `def` надёжнее видна внутри блоков pipeline.
//
//  agent { label 'docker-agent' }
//      ГДЕ выполняется сборка. Выбор идёт по МЕТКЕ ноды, а не по её имени:
//      метку можно повесить на несколько машин, и джоба поедет на любую
//      свободную. Метка задаётся у ноды в UI (Manage Jenkins → Nodes);
//      имя той же ноды — paf-agent-1, см. JENKINS_AGENT_NAME в compose-файле.
//
//  parameters { ... }
//      Поля формы запуска джобы. Читаются в шагах как params.ИМЯ.
//      Появляются в интерфейсе только ПОСЛЕ первого прогона новой версии
//      этого файла: ближайшая сборка после пуша берёт defaultValue
//      и формы не показывает — это ожидаемо, а не поломка.
//
//      SUITE        какой набор тестов гонять: smoke (7 UI-тестов основных
//                   сценариев) или regression (все 15 классов). Тип choice,
//                   а не string: множество сьютов конечное и известно заранее,
//                   а свободный ввод допускает опечатку. Значение — АЛИАС,
//                   путь достраивается в шаге sh; в дропдауне человек видит
//                   короткое имя, а не путь в репозитории.
//                   Внимание: первый элемент списка становится значением
//                   по умолчанию — сейчас это smoke.
//      ENVIRONMENT  против какого стенда гонять. Тоже choice: опечатка
//                   в свободно введённом адресе дороже, чем в имени сьюта —
//                   несуществующий suite-файл Surefire отбивает громко
//                   и с точным путём, а прогон против чужого адреса
//                   развалится кучей невнятных падений в тестах.
//                   Сегодня в списке один пункт: второго стенда
//                   у automationexercise.com не существует.
//
//  environment { ... }
//      Значения, попадающие в прогон переменными окружения. Их читает
//      FrameworkConfig по цепочке env → system property → framework.properties
//      → dbconnect.properties.
//      Порядок в этой цепочке — то, на чём держится вся параметризация:
//      внешние источники стоят ВЫШЕ файлов, поэтому значение из джобы
//      перебивает закоммиченное. При обратном порядке параметр BASE_URL
//      не имел бы силы вовсе (подробнее — javadoc FrameworkConfig.getValue).
//
//      DB_HOST      имя контейнера базы, НЕ localhost: внутри контейнера
//                   агента localhost — это сам агент. Оба контейнера в одной
//                   docker-сети, поэтому имя резолвится встроенным DNS.
//      DB_PORT      внутренний порт Postgres. На хосте база доступна как 5434
//                   (проброс "5434:5432" в docker-compose.yml), но проброс
//                   существует только для доступа с Мака — изнутри сети
//                   идём прямо на 5432.
//      DB_PASSWORD  секрет НЕ хранится в этом файле: репозиторий публичный,
//                   и пароль остался бы в истории коммитов навсегда.
//                   credentials() подставляет значение в момент прогона
//                   по идентификатору секрета, заведённого в Jenkins
//                   (Manage Jenkins → Credentials, тип Secret text).
//      BASE_URL     адрес стенда, добытый из ENV_URLS по выбранному алиасу.
//                   Тот же ключ лежит в framework.properties — и перебивается
//                   отсюда именно за счёт порядка источников, описанного выше.
//
//  stage('test suite run')
//      Имя этапа видно на диаграмме сборки в интерфейсе Jenkins — поэтому
//      оно говорит, что именно прогоняется. Имя перестало называть конкретный
//      сьют, когда набор стал выбираться параметром.
//
//  sh "echo BASE_URL=$BASE_URL, SUITE=${params.SUITE}"
//      Печатает то, что реально приехало в прогон. Нужен потому, что зелёная
//      сборка сама по себе не доказывает, что параметр подействовал: сегодня
//      значение из ENV_URLS совпадает с закоммиченным в framework.properties,
//      и результат прогона одинаков в обоих случаях.
//      Два значения берутся ПО-РАЗНОМУ, и это не оплошность:
//        BASE_URL        объявлен в environment, то есть является переменной
//                        окружения — Groovy разрешает такие по голому имени;
//        params.SUITE    параметром окружения НЕ является. Замерено: первая
//                        версия этой строки печатала "SUITE=" пустым, потому
//                        что переменной SUITE в окружении шага не существует.
//                        params и env — разные пространства, и первое не
//                        является подмножеством второго.
//      Подстановку в двойных кавычках делает Groovy, ДО передачи строки в шелл.
//      Отсюда правило про секреты: любое значение из environment, попавшее
//      в такую строку, окажется в логе сборки открытым текстом. Для BASE_URL
//      это безразлично, для DB_PASSWORD — нет; там страхует credentials(),
//      который Jenkins дополнительно маскирует в выводе.
//
//  sh "mvn clean test ..."
//      -Dsurefire.suiteXmlFile  какой TestNG-сьют запускать. Путь собирается
//          из алиаса: ${params.SUITE} → src/test/resources/test-suites/<алиас>.xml.
//          Строка в ДВОЙНЫХ кавычках — иначе подстановки Groovy не будет.
//          Внимание: имя свойства именно `surefire.suiteXmlFile` — на неизвестное
//          -D Maven не ругается, а молча его игнорирует. Зато на несуществующий
//          ПУТЬ отвечает громко: "Suite file ... is not a valid file", Tests run: 0,
//          BUILD FAILURE. Опечатка в имени свойства тихая, в значении — громкая.
//      -Dselenide.headless      браузер без графического окна. Ключ живёт
//          здесь, а не в FrameworkConfig, потому что наличие экрана —
//          свойство МАШИНЫ, на которой идёт прогон, а не поведения
//          фреймворка (тот же критерий, по которому наружу вынесен
//          surefire.threadNumber). Локально браузер видно, в контейнере
//          экрана нет физически.
//
//  post { always { ... } }
//      Что сделать ПОСЛЕ стадии. always — независимо от её исхода.
//      Почему не следующим шагом в steps: при упавшем тесте `mvn test` вернёт
//      ненулевой код, шаг sh бросит исключение и стадия оборвётся — публикация
//      не выполнилась бы ровно в том случае, ради которого отчёт и нужен.
//      Тот же принцип, что alwaysRun = true у tearDown в BaseTest.
//      Место блока: сосед stages на уровне pipeline (после всех стадий) либо
//      внутри конкретного stage. Внутри самого stages его быть не может —
//      там допустимы только stage.
//
//  allure results: [[path: 'target/allure-results']]
//      Публикация отчёта. Работают ДВЕ разные стороны, и их легко перепутать:
//        пишет      библиотека allure-testng в прогоне — JSON-файлы в
//                   target/allure-results (путь задан в allure.properties);
//        читает     Allure Jenkins Plugin здесь, строит HTML и вешает ссылку
//                   на страницу сборки. Локально ту же работу делает
//                   allure-maven (mvn allure:report) — это разные генераторы
//                   над одними и теми же результатами.
//      Плагину нужен ещё инструмент Allure Commandline: Manage Jenkins → Tools,
//      заведён под именем allure-commandline с автоустановкой. Без него шаг
//      падает; первая сборка после установки дольше — инструмент качается.
//      Зачем плагин, а не HTML Publisher поверх mvn allure:report: историю и
//      тренды между сборками умеет только он — HTML Publisher просто
//      выкладывает готовую папку.
// =============================================================================
ENV_URLS = [Prod: 'https://automationexercise.com']

pipeline {
    agent {label 'docker-agent'}

    parameters {
        choice(name: 'SUITE', choices: ['smoke', 'regression'], description: 'Select a test-suite')
        choice(name: "ENVIRONMENT", choices: ['Prod'], description: "Select test environment")
    }

    environment {
        DB_HOST = 'aqa-postgres'
        DB_PORT = '5432'
        DB_NAME = 'aqa_db'
        DB_USERNAME = 'postgres_user'
        DB_PASSWORD = credentials('DB_PASSWORD')
        BASE_URL ="${ENV_URLS[params.ENVIRONMENT]}"
    }

    stages {
        stage('test suite run') {
            steps {
                sh "echo BASE_URL=$BASE_URL, SUITE=${params.SUITE}"
                sh "mvn clean test -Dsurefire.suiteXmlFile=src/test/resources/test-suites/${params.SUITE}.xml -Dselenide.headless=true"
            }
        }
    }

    post {
        always {
            allure includeProperties: false, results: [[path: 'target/allure-results']]
        }
    }
}
