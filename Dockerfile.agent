# =============================================================================
#  Образ Jenkins-агента — машины, на которой физически идёт `mvn clean test`.
#
#  НАЗНАЧЕНИЕ И МЕСТО В CI/CD
#  Рецепт СБОРКИ образа. Читает его `docker compose build` на локальной машине
#  (сервис paf-agent-1 в docker-compose-jenkins.yml). Jenkins этот файл не
#  открывает никогда — он получает уже готовый контейнер.
#  Следствие: правка здесь действует после пересборки образа, а не после
#  `git push` (в отличие от Jenkinsfile, который читается из GitHub).
#
#  Зачем свой образ. Готового образа с нужным набором не существует: базовый
#  jenkins/inbound-agent даёт JDK и git, но не даёт ни Maven, ни браузера,
#  ни драйвера. Всё, что ниже, — добор недостающего.
#
#  РАЗБОР ЭЛЕМЕНТОВ (по порядку строк)
#
#  FROM jenkins/inbound-agent:jdk21
#      Базовый образ. Тег jdk21 выбран по критерию «стабильная LTS,
#      совместимая с Lombok»: enforcer в pom.xml допускает [17,26), но он
#      проверяет ДИАПАЗОН, а не совместимость — на JDK 26 Lombok молча
#      не отрабатывает. Совместимость с 21 подтверждена сборкой всех
#      34 файлов на этом агенте.
#      Что уже внутри: Temurin 21.0.12, git 2.47.3, agent.jar, юзер jenkins.
#
#  USER root
#      Установка пакетов требует прав root. Последней строкой обязательно
#      возвращаемся к непривилегированному пользователю.
#
#  RUN curl ... maven ...
#      Maven ставится архивом с сайта Apache, а НЕ через `apt-get install maven`.
#      Критерий выбора (сформулирован до выбора): не тащить второй JDK.
#      Замер отвергнутого пути: `apt-get install -s maven` тянет 69 пакетов,
#      включая openjdk-21-jre-headless, при уже живом Temurin 21 в образе.
#      Побочно: с архива берётся 3.9.16 — та же версия, что на рабочей машине,
#      то есть CI и локальный прогон не разъезжаются по версии сборщика.
#      Флаги curl: -o записать в файл (иначе вывод уйдёт в stdout и файла
#      не будет), -L идти за редиректами, -f падать на HTTP-ошибке,
#      -s без индикатора прогресса.
#      Скачивание, распаковка и удаление архива — одной инструкцией, чтобы
#      архив не остался внутри образа лишним слоем.
#
#  ENV PATH=...
#      Распакованный Maven лежит вне системных путей. Без этой строки `mvn`
#      не найдётся, и отказ выглядел бы как «Maven не установился».
#
#  RUN apt-get update && apt-get install -y chromium chromium-driver
#      `apt-get update` обязателен ПЕРЕД install: без него локальный список
#      пакетов пуст и любой пакет «не найден», даже если он существует.
#      chromium        — сам браузер, нужен 7 классам из regression.xml.
#      chromium-driver — ключевая часть, появилась не сразу и не просто так:
#      Selenium Manager умеет качать chromedriver сам — и качал, но брал
#      сборку linux64 (x86-64), потому что Google публикует chromedriver
#      для Linux ТОЛЬКО под x86-64. Контейнер на Apple Silicon — aarch64,
#      и такой бинарник на нём не исполняется: `rosetta error: failed to
#      open elf`. Наружу это выходило как SessionNotCreated без единой
#      подробности о причине. Пакет Debian собран под ARM и совпадает
#      с браузером по версии.
#
#  USER jenkins
#      Возврат к непривилегированному пользователю: под root дальше работать
#      не надо, и сам Chromium под root без дополнительных флагов не стартует.
# =============================================================================

FROM jenkins/inbound-agent:jdk21
USER root
RUN curl https://dlcdn.apache.org/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.tar.gz -o /tmp/maven.tar.gz -L -f -s && tar -zxf /tmp/maven.tar.gz -C /opt && rm /tmp/maven.tar.gz
ENV PATH="${PATH}:/opt/apache-maven-3.9.16/bin"
RUN apt-get update && apt-get install -y chromium chromium-driver
USER jenkins
